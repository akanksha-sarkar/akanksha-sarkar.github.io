---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>

  <!-- Intro -->
  <section class="flex flex-col sm:flex-row gap-8 items-center mt-4 mb-16">
    <div class="flex-1 min-w-0">
      <h1 class="text-3xl font-semibold tracking-tight text-[#1C1410] mb-1">Akanksha Sarkar</h1>
      <p class="text-[#7A6B5D] text-sm mb-5">
        MS CS @ Cornell University &middot;
        <a href="mailto:as2637@cornell.edu" class="text-[#9B2335] hover:underline">as2637@cornell.edu</a>
      </p>
      <p class="text-[15px] leading-relaxed text-[#1C1410] mb-6">
        I am a second-year MS student in Computer Science at Cornell University. I am broadly
        interested in Computer Vision and AI4Science, and am currently working on using agents for
        scientific applications. I am fortunate to be advised by
        <a href="https://jenniferjsun.com/" target="_blank" rel="noopener noreferrer" class="text-[#9B2335] hover:underline">Prof. Jennifer Sun</a>.
        Previously, I earned my B.A. in Math and Computer Science from Cornell University.
        Feel free to reach out for a chat or collaboration.
      </p>
      <div class="flex flex-wrap gap-2">
        <a href="mailto:as2637@cornell.edu" class="px-4 py-1.5 rounded-full border border-[#E8E0D5] text-[13px] text-[#1C1410] hover:border-[#9B2335] hover:text-[#9B2335] transition-colors">Email</a>
        <a href="https://github.com/akanksha-sarkar" target="_blank" rel="noopener noreferrer" class="px-4 py-1.5 rounded-full border border-[#E8E0D5] text-[13px] text-[#1C1410] hover:border-[#9B2335] hover:text-[#9B2335] transition-colors">GitHub</a>
        <a href="https://scholar.google.com/citations?user=vqgMp2gAAAAJ&hl=en&oi=ao" target="_blank" rel="noopener noreferrer" class="px-4 py-1.5 rounded-full border border-[#E8E0D5] text-[13px] text-[#1C1410] hover:border-[#9B2335] hover:text-[#9B2335] transition-colors">Google Scholar</a>
      </div>
    </div>
    <div class="shrink-0">
      <img
        src="/profile_picture.jpeg"
        alt="Akanksha Sarkar"
        class="w-36 h-40 rounded-2xl object-cover object-top shadow-sm"
      />
    </div>
  </section>

  <!-- News -->
  <section id="news" class="mb-16">
    <h2 class="text-base font-semibold text-[#1C1410] mb-4">News</h2>
    <div class="border-t border-[#E8E0D5]">
      <div class="flex gap-6 py-3 border-b border-[#E8E0D5]">
        <span class="text-[13px] text-[#7A6B5D] w-48 shrink-0 pt-px">May 2026</span>
        <span class="text-[13px] text-[#1C1410]">Started as ML Engineer Intern on the Siri team at Apple.</span>
      </div>
      <div class="flex gap-6 py-3 border-b border-[#E8E0D5]">
        <span class="text-[13px] text-[#7A6B5D] w-48 shrink-0 pt-px">August 2025</span>
        <span class="text-[13px] text-[#1C1410]">Started MS in Computer Science at Cornell University.</span>
      </div>
    </div>
  </section>

  <!-- Publications -->
  <section id="research" class="mb-16">
    <h2 class="text-base font-semibold text-[#1C1410] mb-4">Publications</h2>
    <div class="border-t border-[#E8E0D5]">

      <!-- AgentSSL -->
      <div class="flex gap-5 py-5 border-b border-[#E8E0D5] rounded-lg px-3 -mx-3 hover:bg-[#F5EDE8] transition-all duration-200 cursor-default">
        <img src="/agentssl.png" alt="AgentSSL" class="w-56 h-36 rounded-lg object-contain shrink-0 bg-white" />
        <div class="flex flex-col justify-center gap-1.5">
          <h3 class="font-medium text-[15px] text-[#1C1410] leading-snug">
            AgentSSL: Can MLE Agents Leverage Unlabeled Data?
          </h3>
          <p class="text-[13px] text-[#7A6B5D]">
            <span class="text-[#9B2335] font-medium">Akanksha Sarkar*</span>, Ethan Lin*, Ziang Liu, Kristin Branson, Jennifer J. Sun
          </p>
          <p class="text-[13px] text-[#6B7A3A] font-medium">In Submission to NeurIPS 2026</p>
          <div class="flex items-center gap-2 mt-0.5">
            <span class="px-3 py-0.5 rounded-full border border-[#D4C5BE] text-[12px] text-[#7A6B5D]">Coming Soon</span>
          </div>
        </div>
      </div>

      <!-- FormulaCode -->
      <div class="flex gap-5 py-5 border-b border-[#E8E0D5] rounded-lg px-3 -mx-3 hover:bg-[#F5EDE8] transition-all duration-200 cursor-default">
        <img src="/formula.png" alt="FormulaCode" class="w-56 h-36 rounded-lg object-contain shrink-0 bg-white" />
        <div class="flex flex-col justify-center gap-1.5">
          <h3 class="font-medium text-[15px] text-[#1C1410] leading-snug">
            FormulaCode: Evaluating Agentic Optimization on Large Codebases
          </h3>
          <p class="text-[13px] text-[#7A6B5D]">
            Atharva Sehgal*, James Hou*, <span class="text-[#9B2335] font-medium">Akanksha Sarkar</span>, Ishaan Mantripragada, Swarat Chaudhuri, Jennifer J. Sun, Yisong Yue
          </p>
          <p class="text-[13px] text-[#6B7A3A] font-medium">accepted at ICML 2026</p>
          <div class="flex items-center gap-2 flex-wrap mt-0.5">
            <a href="https://arxiv.org/abs/2603.16011" target="_blank" rel="noopener noreferrer"
              class="px-3 py-0.5 rounded-full border border-[#D4C5BE] text-[12px] text-[#7A6B5D] hover:border-[#9B2335] hover:text-[#9B2335] transition-colors">
              ArXiv
            </a>
            <a href="https://formulacode.org/" target="_blank" rel="noopener noreferrer"
              class="px-3 py-0.5 rounded-full border border-[#D4C5BE] text-[12px] text-[#7A6B5D] hover:border-[#9B2335] hover:text-[#9B2335] transition-colors">
              Project Page
            </a>
          </div>
        </div>
      </div>

      <!-- Bioacoustics -->
      <div class="flex gap-5 py-5 border-b border-[#E8E0D5] rounded-lg px-3 -mx-3 hover:bg-[#F5EDE8] transition-all duration-200 cursor-default">
        <img src="/bioacoustics.png" alt="Bioacoustics" class="w-56 h-36 rounded-lg object-contain shrink-0 bg-white" />
        <div class="flex flex-col justify-center gap-1.5">
          <h3 class="font-medium text-[15px] text-[#1C1410] leading-snug">
            Agentic Discovery of Multi-Channel Bioacoustic Association Algorithms
          </h3>
          <p class="text-[13px] text-[#7A6B5D]">
            Paramjyoti Mohapatra, Irina Tolkova, <span class="text-[#9B2335] font-medium">Akanksha Sarkar</span>, Atharva Sehgal, Daniel P. Salisbury, Andrew L. Von Duyke, Léa Bouffaut, Holger Klinck, Jennifer J. Sun
          </p>
          <p class="text-[13px] text-[#6B7A3A] font-medium">accepted at FM4Science @ ICLR 2026</p>
          <div class="flex items-center gap-2 flex-wrap mt-0.5">
            <a href="https://openreview.net/pdf?id=JzKBhjoHad" target="_blank" rel="noopener noreferrer"
              class="px-3 py-0.5 rounded-full border border-[#D4C5BE] text-[12px] text-[#7A6B5D] hover:border-[#9B2335] hover:text-[#9B2335] transition-colors">
              Paper
            </a>
          </div>
        </div>
      </div>

      <!-- NCD -->
      <div class="flex gap-5 py-5 border-b border-[#E8E0D5] rounded-lg px-3 -mx-3 hover:bg-[#F5EDE8] transition-all duration-200 cursor-default">
        <img src="/proj.png" alt="Novel Class Discovery" class="w-56 h-36 rounded-lg object-contain shrink-0 bg-white" />
        <div class="flex flex-col justify-center gap-1.5">
          <h3 class="font-medium text-[15px] text-[#1C1410] leading-snug">
            How many classes do we need to see for novel class discovery?
          </h3>
          <p class="text-[13px] text-[#7A6B5D]">
            <span class="text-[#9B2335] font-medium">Akanksha Sarkar</span>, Been Kim, Jennifer J. Sun
          </p>
          <p class="text-[13px] text-[#6B7A3A] font-medium">accepted at DG-EBF @ CVPR 2025</p>
          <div class="flex items-center gap-2 flex-wrap mt-0.5">
            <a href="https://arxiv.org/abs/2509.15585" target="_blank" rel="noopener noreferrer"
              class="px-3 py-0.5 rounded-full border border-[#D4C5BE] text-[12px] text-[#7A6B5D] hover:border-[#9B2335] hover:text-[#9B2335] transition-colors">
              ArXiv
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Teaching -->
  <section id="teaching" class="mb-16">
    <h2 class="text-base font-semibold text-[#1C1410] mb-4">Teaching</h2>
    <div class="border-t border-[#E8E0D5]">
      {[
        { term: "Spring 2026",              course: "CS 4782 — Introduction to Deep Learning" },
        { term: "Fall 2025",                course: "CS 6784 — Research Design for Machine Learning" },
        { term: "Spring 2025",              course: "CS 4820 — Introduction to Analysis of Algorithms" },
        { term: "Fall 2023",                course: "CS 3110 — Functional Programming with OCaml" },
        { term: "Spring 2022 – Spring 2023", course: "Math 1120 — Calculus II (Course Consultant)" },
      ].map(({ term, course }) => (
        <div class="flex gap-6 py-3 border-b border-[#E8E0D5]">
          <span class="text-[13px] text-[#7A6B5D] w-48 shrink-0 pt-px">{term}</span>
          <span class="text-[13px] text-[#1C1410]">{course}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Awards -->
  <section id="awards" class="mb-16">
    <h2 class="text-base font-semibold text-[#1C1410] mb-4">Awards</h2>
    <div class="border-t border-[#E8E0D5]">
      {[
        { year: "2025", award: "CRA Outstanding Undergraduate Research Award nomination" },
        { year: "2024", award: "Cornell University Milstein Summer Research Grant" },
        { year: "2023", award: "HackNITR Hackathon, Excellence Award" },
      ].map(({ year, award }) => (
        <div class="flex gap-6 py-3 border-b border-[#E8E0D5]">
          <span class="text-[13px] text-[#7A6B5D] w-10 shrink-0 pt-px">{year}</span>
          <span class="text-[13px] text-[#1C1410]">{award}</span>
        </div>
      ))}
    </div>
  </section>

</BaseLayout>
